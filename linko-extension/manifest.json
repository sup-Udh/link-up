{
  "manifest_version": 3,
  "name": "Linko",
  "version": "1.0",

  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "host_permissions": [
    "https://leetcode.com/*",
    "http://localhost/*",
    "https://2212-49-207-225-191.ngrok-free.app /*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "http://localhost/*",
        "http://localhost:*/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}