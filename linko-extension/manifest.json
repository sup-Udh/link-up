{
  "manifest_version": 3,
  "name": "Linko",
  "version": "1.0",

  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "host_permissions": [
    "https://leetcode.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.ngrok-free.app/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "http://localhost/*",
        "http://localhost:*/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:*/*",
        "https://*.ngrok-free.app/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}