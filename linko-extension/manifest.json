{
  "manifest_version": 3,
  "name": "Linko",
  "version": "1.0",

  "permissions": [
    "activeTab",
    "storage"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "host_permissions": [
    "https://leetcode.com/*",
    "https://handiness-glucose-munchkin.ngrok-free.dev/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}